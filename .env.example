DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trailquest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trailquest
DB_PORT=5432

OSRM_BASE_URL=http://localhost:5000/route/v1/foot
OSRM_PORT=5000

INFERENCE_ENDPOINT_URL=https://inference.digitalocean.com/v1
INFERENCE_API_KEY=your_do_inference_api_key
INFERENCE_MODEL_NAME=gemma-3

HERMES_SKILLS_DIR=~/.hermes/skills

# Reddit Scraping via Apify (Recommended — instant signup, no 2-4 week developer review)
# Create a free account at https://apify.com and get your API token from Console -> Integrations
APIFY_API_TOKEN=your_apify_api_token
APIFY_ACTOR_ID=apify/reddit-scraper

# Official Reddit API (Optional legacy — requires approved Reddit script application)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=trailquest-harvester/1.0 by your_reddit_username

# Overpass API — public endpoint, no key needed; swap for a self-hosted instance under load
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=60

# Nominatim — OSM usage policy: max 1 req/sec, identify your app in User-Agent
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=trailquest-harvester/1.0
NOMINATIM_RATE_LIMIT_SEC=1.0

# Deduplication threshold in meters — new landmarks within this radius of an existing one are dropped
DEDUP_RADIUS_METERS=50.0
